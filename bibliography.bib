@mastersthesis{Wenkai,
  author = {Fan, Wenkai},
  title = {Suspect Screening and Semi-Quantification of Organic Contaminants in Snow and Water Samples on the Qinghai--Tibet Plateau and High Mountain Regions},
  school = {The College of Wooster},
  address = {Wooster, OH},
  year = {2025},
  type = {Undergraduate Thesis},
  note = {Unpublished thesis},

  abstract = {This study investigates the presence of environmental contaminants in high-altitude water and snow samples collected from remote regions, including Mount Everest, Qinghai lakes, Tibetan rivers, Kilimanjaro, and multiple alpine snow environments. Results reveal herbicides, pharmaceuticals, industrial compounds, and anthropogenic markers, demonstrating long-range pollutant transport and human impact even in remote ecosystems.},

  annote = {This thesis provides a comprehensive application of suspect screening and semi-quantitative analysis of organic contaminants in remote high-altitude environments using high-resolution mass spectrometry (HRMS). 
  While the primary focus is on environmental chemistry and pollution transport mechanisms, it also exemplifies the use of advanced analytical techniques and data interpretation methods relevant to computational approaches for molecule identification. 
  The utilization of HRMS data to detect and tentatively identify a broad spectrum of known contaminants aligns with the goals of non-targeted analysis in metabolomics and environmental studies. 
  Furthermore, the study's emphasis on suspect screening, combined with high-resolution data acquisition, underscores the importance of sophisticated data mining strategies—such as molecular networking, clustering, and multidimensional analysis—in revealing unknown or unexpected compounds. 
  As such, this work offers valuable insights and a real-world context for developing computational frameworks aimed at the annotation and structural elucidation of unknown molecules, especially when integrated with molecular networking tools and machine learning algorithms in cheminformatics.}
}

@article{Kind,
author = {Kind, Tobias and Tsugawa, Hiroshi and Cajka, Tomas and Ma, Yan and Lai, Zijuan and Mehta, Sajjan S. and Wohlgemuth, Gert and Barupal, Dinesh Kumar and Showalter, Megan R. and Arita, Masanori and Fiehn, Oliver},
title = {Identification of small molecules using accurate mass MS/MS search},
journal = {Mass Spectrometry Reviews},
volume = {37},
number = {4},
pages = {513-532},
keywords = {compound identification, high-resolution mass spectrometry, library search, tandem mass spectrometry},
doi = {https://doi.org/10.1002/mas.21535},
url = {https://analyticalsciencejournals.onlinelibrary.wiley.com/doi/abs/10.1002/mas.21535},
eprint = {https://analyticalsciencejournals.onlinelibrary.wiley.com/doi/pdf/10.1002/mas.21535},
abstract = {Tandem mass spectral library search (MS/MS) is the fastest way to correctly annotate MS/MS spectra from screening small molecules in fields such as environmental analysis, drug screening, lipid analysis, and metabolomics. The confidence in MS/MS-based annotation of chemical structures is impacted by instrumental settings and requirements, data acquisition modes including data-dependent and data-independent methods, library scoring algorithms, as well as post-curation steps. We critically discuss parameters that influence search results, such as mass accuracy, precursor ion isolation width, intensity thresholds, centroiding algorithms, and acquisition speed. A range of publicly and commercially available MS/MS databases such as NIST, MassBank, MoNA, LipidBlast, Wiley MSforID, and METLIN are surveyed. In addition, software tools including NIST MS Search, MS-DIAL, Mass Frontier, SmileMS, Mass++, and XCMS2 to perform fast MS/MS search are discussed. MS/MS scoring algorithms and challenges during compound annotation are reviewed. Advanced methods such as the in silico generation of tandem mass spectra using quantum chemistry and machine learning methods are covered. Community efforts for curation and sharing of tandem mass spectra that will allow for faster distribution of scientific discoveries are discussed.},
year = {2018},
annote = {This review explains how to identify small molecules using high-resolution MS/MS techniques. 
It highlights the importance of spectral libraries that include experimental data and computer-generated spectra. 
The article covers methods for creating in silico spectra using various software tools and developing new databases. 
It also stresses the need for proper data curation and quality control. From my point of view, it provides valuable insights into how computational approaches and shared spectral resources can aid in analyzing complex samples.
These methods are especially helpful for identifying unknown compounds in environmental or natural product research.}
}

@article{Schymanski,
author = {Schymanski, Emma L. and Jeon, Junho and Gulde, Rebekka and Fenner, Kathrin and Ruff, Matthias and Singer, Heinz P. and Hollender, Juliane},
title = {Identifying Small Molecules via High Resolution Mass Spectrometry: Communicating Confidence},
journal = {Environmental Science \& Technology},
volume = {48},
number = {4},
pages = {2097-2098},
year = {2014},
doi = {10.1021/es5002105},
URL = {https://doi.org/10.1021/es5002105},
eprint = {https://doi.org/10.1021/es5002105},
annote = {
This viewpoint article is essential for non-targeted analysis (NTA) research using HR-MS, such as the computational identification of unknown contaminants in remote environments. 
It proposes a five-level confidence system for molecular identification, addressing the limitations inherent when reference standards are absent. 
The framework provides the necessary rigor for reporting the results of computational tools like molecular networking or cluster analysis. 
Specifically, Level 3 (Tentative candidate(s)) helps classify structures where computational methods suggest isomers, while Levels 4 and 5 establish clear reporting standards for masses and formulas that serve as critical input or nodes in network-based analysis, enabling transparent data exchange and future traceability of unknown molecules.
}
}

@article{Ye,
author = {Ye, Weiting and Li, Jingcheng and Cai, Xianfa},
title = {Mfgnn: Multi-Scale Feature-Attentive Graph Neural Networks for Molecular Property Prediction},
journal = {Journal of Computational Chemistry},
volume = {46},
number = {3},
pages = {e70011},
keywords = {deep learning, graph neural network, molecular property prediction},
doi = {https://doi.org/10.1002/jcc.70011},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/jcc.70011},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/jcc.70011},
abstract = {ABSTRACT In the realm of artificial intelligence-driven drug discovery (AIDD), accurately predicting the influence of molecular structures on their properties is a critical research focus. While deep learning models based on graph neural networks (GNNs) have made significant advancements in this area, prior studies have primarily concentrated on molecule-level representations, often neglecting the impact of functional group structures and the potential relationships between fragments on molecular property predictions. To address this gap, we introduce the multi-scale feature attention graph neural network (MfGNN), which enhances traditional atom-based molecular graph representations by incorporating fragment-level representations derived from chemically synthesizable BRICS fragments. MfGNN not only effectively captures both the structural information of molecules and the features of functional groups but also pays special attention to the potential relationships between fragments, exploring how they collectively influence molecular properties. This model integrates two core mechanisms: a graph attention mechanism that captures embeddings of molecules and functional groups, and a feature extraction module that systematically processes BRICS fragment-level features to uncover relationships among the fragments. Our comprehensive experiments demonstrate that MfGNN outperforms leading machine learning and deep learning models, achieving state-of-the-art performance in 8 out of 11 learning tasks across various domains, including physical chemistry, biophysics, physiology, and toxicology. Furthermore, ablation studies reveal that the integration of multi-scale feature information and the feature extraction module enhances the richness of molecular features, thereby improving the model's predictive capabilities.},
year = {2025},
annote = {This study introduces MfGNN, a multi-scale feature-attentive graph neural network designed for molecular property prediction by capturing both atom-level and fragment-level structural features. 
While its primary focus is on predicting molecular properties, the methodologies—particularly the integration of fragment-based representations and inter-fragment relationship modeling—offer valuable insights for non-targeted analysis in high-resolution mass spectrometry. 
Its ability to systematically incorporate substructural information and learn complex molecular relationships aligns with the objectives of molecular networking and cluster analysis, moving beyond traditional structure assignment based solely on mass spectra. 
Incorporating such graph-based machine learning frameworks can enhance the annotation, classification, and clustering of unknown molecules in environmental samples, especially in remote and contaminated regions. 
Therefore, this work provides a computationally advanced approach that can significantly contribute to the development of chemoinformatics tools for high-resolution mass spectrometry in non-targeted environmental studies.}
}

@article{Manz,
author = {Manz, K. E., Feerick, A., Braun, J. M., Feng, Y. L., Hall, A., Koelmel, J., Manzano, C., Newton, S. R., Pennell, K. D., Place, B. J., Godri Pollitt, K. J., Prasse, C., & Young, J. A.},
title = {Non-targeted analysis (NTA) and suspect screening analysis (SSA): A review of examining the chemical exposome},
journal = {Journal of Exposure Science & Environmental Epidemiology},
volume = {33(4)},
pages = {524-536},
keywords = {deep learning, graph neural network, molecular property prediction},
doi = {https://doi.org/10.1038/s41370-023-00574-6},
url = {https://www.nature.com/articles/s41370-023-00574-6},
abstract = {Non-targeted analysis (NTA) and suspect screening analysis (SSA) are powerful techniques that rely on high-resolution mass spectrometry (HRMS) and computational tools to detect and identify unknown or suspected chemicals in the exposome. Fully understanding the chemical exposome requires characterization of both environmental media and human specimens. As such, we conducted a review to examine the use of different NTA and SSA methods in various exposure media and human samples, including the results and chemicals detected. The literature review was conducted by searching literature databases, such as PubMed and Web of Science, for keywords, such as “non-targeted analysis”, “suspect screening analysis” and the exposure media. Sources of human exposure to environmental chemicals discussed in this review include water, air, soil/sediment, dust, and food and consumer products. The use of NTA for exposure discovery in human biospecimen is also reviewed. The chemical space that has been captured using NTA varies by media analyzed and analytical platform. In each media the chemicals that were frequently detected using NTA were: per- and polyfluoroalkyl substances (PFAS) and pharmaceuticals in water, pesticides and polyaromatic hydrocarbons (PAHs) in soil and sediment, volatile and semi-volatile organic compounds in air, flame retardants in dust, plasticizers in consumer products, and plasticizers, pesticides, and halogenated compounds in human samples. Some studies reviewed herein used both liquid chromatography (LC) and gas chromatography (GC) HRMS to increase the detected chemical space (16%); however, the majority (51%) only used LC-HRMS and fewer used GC-HRMS (32%). Finally, we identify knowledge and technology gaps that must be overcome to fully assess potential chemical exposures using NTA. Understanding the chemical space is essential to identifying and prioritizing gaps in our understanding of exposure sources and prior exposures.},
year = {2023},
annote = {This review article critically discusses the application of high-resolution mass spectrometry (HRMS) in non-targeted analysis (NTA) and suspect screening analysis (SSA) for environmental and human exposure assessment. 
It highlights the importance of computational tools, database searching, and software workflows in identifying unknown chemicals within complex matrices. 
Although traditional NTA focuses on assigning structures based on spectral data, this paper underscores emerging strategies such as spectral library matching, in silico predictions, and the use of software for molecular formula generation. 
Importantly, it identifies gaps in open-source software development and emphasizes the need for advanced computational approaches such as molecular networking and cluster analysis to enhance the annotation and interpretation of unidentified HRMS features. 
This aligns with my research focus on employing computational techniques to facilitate the molecular networking of unknown compounds detected in remote environmental samples. 
It emphasizes moving beyond mere mass-based identification towards relationship-based clustering and annotation of molecular families. 
The review's discussion on integrating multiple analytical platforms and expanding spectral libraries directly informs the development of machine learning and network-based tools for the comprehensive characterization of organic contaminants in extreme and understudied environments.}
}

@article{Nino-Suastegui,
title = {Non-targeted analysis and suspect screening of organic contaminants in temperate snowfall using liquid chromatography high-resolution mass spectrometry},
journal = {Environmental Research},
volume = {266},
pages = {120494},
year = {2025},
issn = {0013-9351},
doi = {https://doi.org/10.1016/j.envres.2024.120494},
url = {https://www.sciencedirect.com/science/article/pii/S0013935124024010},
author = {Stephanie Nino-Suastegui and Eve Painter and Jameson W. Sprankle and Jillian J. Morrison and Jennifer A. Faust and Rebekah Gray},
keywords = {Non-targeted analysis, Suspect screening, Snow, High-resolution mass spectrometry, Environmental contaminants, Pesticides, SIRIUS},
abstract = {Contaminants released into the atmosphere that undergo regional and long-range transport can deposit back to Earth through snowfall. 
When snow melts, these contaminants re-enter the environment, sometimes far from their original emission sources. Here we present the first comprehensive characterization of organic contaminants in snow from North America. Fresh snowfall samples were collected in the central United States over a three-year period and measured by liquid chromatography high-resolution mass spectrometry for suspect screening and non-targeted analysis. 
The resulting data set was screened against experimental MS/MS libraries and underwent supplemental in silico MS/MS analysis. In total, 91 possible compounds were tentatively identified in snow, and 17 were successfully confirmed and semi-quantified with reference standards. These contaminants were mostly anthropogenic in origin and included six herbicides, three insect repellants, one insecticide metabolite, and one fungicide. The most prominent compounds present in all samples were N-cyclohexylformamide (known contaminant in tire leachate), DEET (insect repellent), and dimethyl phthalate (plasticizer), with median deposition fluxes of 4032, 284, and 262 ng m−2, respectively. Three additional compounds were detected in 100% of samples: coumarin (phytochemical and fragrance additive), 5-methylbenzotriazole (antifreeze component), and quinoline (heterocyclic aromatic). The Peto-Peto test revealed statistically significant differences in deposition fluxes for these six contaminants (p < 0.05), with weak but statistically significant positive associations between coumarin and DEET and between coumarin and quinoline according to a Kendall's tau correlation analysis. These findings demonstrate the utility of in silico analysis to complement MS/MS matching with experimental databases. Even so, thousands of unidentified features remained in the data set, highlighting the limitations of current strategies in non-targeted analysis of environmental samples.},
annote = {This paper by Nino-Suastegui et al. (2025), authored by a former student of my advisor working on non-targeted analysis of environmental contaminants, explores the use of liquid chromatography high-resolution mass spectrometry (LC-HRMS) combined with in silico tools like SIRIUS and CSI:FingerID for suspect screening and compound annotation in snow samples. 
The study successfully identified 17 known organic contaminants, mostly anthropogenic, including herbicides, insecticides, and plasticizers, and demonstrated how computational methods can aid in tentatively identifying unknown features beyond traditional library matching. 
The work emphasizes the challenge of numerous unidentified features remaining in environmental samples and shows that in silico analysis can complement existing databases, which is directly relevant to my research focus on improving computational techniques for molecule identification in complex environmental matrices.}
}

@article{Chao,
author = {Chao, Alex and Minucci, Jeffrey M. and Ferland, Troy M. and Carr, E. Tyler and Janesch, Greg and Rizwan, Safia and Whitehead, Heather D. and Cathey, Tommy and Pu, Shirley and Brunelle, Laura D. and Batt, Angela L. and Sobus, Jon R. and Williams, Antony J.},
title = {Prioritizing Chemical Candidates from Non-targeted Analysis Using Metadata, Spectral Similarity, and Hazard Scoring within INTERPRET NTA},
journal = {Analytical Chemistry},
volume = {97},
number = {29},
pages = {15904-15912},
year = {2025},
doi = {10.1021/acs.analchem.5c02223},
note ={PMID: 40670324},
URL = {https://doi.org/10.1021/acs.analchem.5c02223},
eprint = {https://doi.org/10.1021/acs.analchem.5c02223},
annote = {This study introduces INTERPRET NTA, a computational tool that enhances non-targeted analysis (NTA) by integrating spectral similarity, metadata, and hazard data to prioritize chemical candidates detected via high-resolution mass spectrometry (HRMS). 
While traditional NTA approaches focus on structure annotation based primarily on mass spectral matching, this work emphasizes data-driven prioritization and visualization strategies that facilitate the identification of relevant chemicals within complex environmental matrices. 
The methodologies described, particularly the use of spectral similarity scoring and interactive visualization, align with advanced computational approaches such as molecular networking and cluster analysis. 
These techniques are critical for exploring unknown molecules in HRMS datasets. 
Applying these strategies to remote environmental samples like those from Mount Everest, Kilimanjaro, or Tibetan rivers could significantly enhance the discovery and characterization of unannotated organic contaminants by enabling network-based clustering and contextual prioritization beyond mere structure assignment. 
This work informs the development of computational frameworks that support the spectral and metadata-driven exploration of large and complex HRMS datasets, which is highly relevant for research efforts aiming to discover and annotate unknown environmental molecules in remote terrestrial and ecological contexts.}
}

@article{Fisher,
author = {Fisher, C.M., Peter, K.T., Newton, S.R. et al.},
title = {Approaches for assessing performance of high-resolution mass spectrometry–based non-targeted analysis methods},
journal = {Anal Bioanal Chem},
volume = {414},
pages = {6455-6471},
year = {2022},
doi = {https://doi.org/10.1007/s00216-022-04203-3},
URL = {https://doi.org/10.1007/s00216-022-04203-3},
annote = {This research paper provides a comprehensive overview of the current state and challenges associated with performance assessment of high-resolution mass spectrometry (HRMS)–based non-targeted analysis (NTA) methods, emphasizing the need for standardized metrics and frameworks. 
For my study on computational identification of unknown molecules via HRMS, particularly in analyzing organic contaminants in remote environments such as Mount Everest, Mt. Kilimanjaro, and Tibetan rivers, this paper offers valuable insights into the evaluation criteria and reliability of NTA workflows beyond simple structural assignment. 
It highlights the importance of robust performance metrics, which are critical when deploying computational approaches like molecular networking and cluster analysis to interpret complex environmental data. 
The focus on qualitative performance metrics such as confidence in chemical identification can guide my development of algorithms for spectral clustering and molecular network construction. 
These strategies will ensure meaningful differentiation of unknowns and proper assessment of confidence levels. Overall, the paper situates my computational methods within the broader context of NTA validity and underscores the necessity of standardized evaluation strategies. 
These strategies are especially relevant when working with large, diverse datasets collected from remote or extreme locations.}
}

@article{Schmid,
author = {Schmid, Robin, Daniel Petras, Louis-Félix Nothias, Mingxun Wang, Allegra T. Aron, Annika Jagels, Hiroshi Tsugawa et al.},
title = {Ion Identity Molecular Networking for Mass Spectrometry-based Metabolomics in the GNPS Environment.},
journal = {Nature Communications},
volume = {12},
number = {3832},
year = {2021},
doi = {https://doi.org/10.1038/s41467-021-23953-9},
URL = {https://doi.org/10.1038/s41467-021-23953-9},
annote = {This research article on Ion Identity Molecular Networking (IIMN) significantly advances the field of non-targeted metabolomics by providing a robust computational framework for connecting different ion species of the same molecule within high-resolution mass spectrometry data. 
While much of the prior work in my project focuses on identifying unknown organic contaminants in remote environments such as Mount Everest, Mt. Kilimanjaro, and Tibet River—areas where many compounds remain uncharacterized—this paper offers valuable insights into how molecular networking can be used to cluster related ions and structurally similar molecules beyond simple mass-to-charge matching. 
The integration of ion identity networks into molecular networking enhances the ability to propagate annotations, expand spectral libraries, and improve the connectivity of unknown features. 
This ultimately facilitates more comprehensive and accurate characterization of complex environmental samples. 
I see this approach as a vital computational tool for my research, enabling me to better understand the relationships between unknown molecules and known clusters, and to develop a more effective non-targeted analysis framework grounded in chemistry and computational analysis.}
}

@Article{Ernst,
AUTHOR = {Ernst, Madeleine and Kang, Kyo Bin and Caraballo-Rodríguez, Andrés Mauricio and Nothias, Louis-Felix and Wandy, Joe and Chen, Christopher and Wang, Mingxun and Rogers, Simon and Medema, Marnix H. and Dorrestein, Pieter C. and van der Hooft, Justin J.J.},
TITLE = {MolNetEnhancer: Enhanced Molecular Networks by Integrating Metabolome Mining and Annotation Tools},
JOURNAL = {Metabolites},
VOLUME = {9},
YEAR = {2019},
NUMBER = {7},
ARTICLE-NUMBER = {144},
URL = {https://www.mdpi.com/2218-1989/9/7/144},
PubMedID = {31315242},
ISSN = {2218-1989},
ABSTRACT = {Metabolomics has started to embrace computational approaches for chemical interpretation of large data sets. Yet, metabolite annotation remains a key challenge. Recently, molecular networking and MS2LDA emerged as molecular mining tools that find molecular families and substructures in mass spectrometry fragmentation data. Moreover, in silico annotation tools obtain and rank candidate molecules for fragmentation spectra. Ideally, all structural information obtained and inferred from these computational tools could be combined to increase the resulting chemical insight one can obtain from a data set. However, integration is currently hampered as each tool has its own output format and efficient matching of data across these tools is lacking. Here, we introduce MolNetEnhancer, a workflow that combines the outputs from molecular networking, MS2LDA, in silico annotation tools (such as Network Annotation Propagation or DEREPLICATOR), and the automated chemical classification through ClassyFire to provide a more comprehensive chemical overview of metabolomics data whilst at the same time illuminating structural details for each fragmentation spectrum. We present examples from four plant and bacterial case studies and show how MolNetEnhancer enables the chemical annotation, visualization, and discovery of the subtle substructural diversity within molecular families. We conclude that MolNetEnhancer is a useful tool that greatly assists the metabolomics researcher in deciphering the metabolome through combination of multiple independent in silico pipelines.},
DOI = {10.3390/metabo9070144},
annote = {This paper on MolNetEnhancer aligns closely with my research focus on the computational identification of unknown molecules using high-resolution mass spectrometry. 
While traditional approaches often rely solely on structure annotation for unknowns, MolNetEnhancer exemplifies an advanced, integrative methodology that leverages molecular networking, substructure discovery (MS2LDA), and in silico annotation tools to explore the chemical diversity within complex datasets. 
Its emphasis on non-targeted, cluster-based analysis for natural and synthetic metabolomes provides a valuable framework for my work, particularly in analyzing organic contaminants or complex mixtures from remote areas such as Mount Everest, Mt. Kilimanjaro, and Tibet River. 
By employing similar network-based strategies, I can enhance the detection, classification, and structural inference of unknown molecules beyond mere mass data, facilitating deeper insights into uncharacterized environmental chemicals through computational metabolomics.}
}

@article{Olivon,
author = {Olivon, Florent and Grelier, Gwendal and Roussi, Fanny and Litaudon, Marc and Touboul, David},
title = {MZmine 2 Data-Preprocessing To Enhance Molecular Networking Reliability},
journal = {Analytical Chemistry},
volume = {89},
number = {15},
pages = {7836-7840},
year = {2017},
doi = {10.1021/acs.analchem.7b01563},
note ={PMID: 28644610},
URL = {https://doi.org/10.1021/acs.analchem.7b01563},
eprint = {https://doi.org/10.1021/acs.analchem.7b01563},
annote = {This paper by Olivon et al. (2017) provides valuable insights into improving molecular networking workflows for untargeted mass spectrometry data analysis. 
It addresses limitations related to isomer resolution, quantification, and compound annotation by integrating MZmine 2 and custom Python scripts. 
Although the study focuses on natural products and plant extracts, its approach to preprocessing high-resolution MS/MS data can be adapted to my research on non-targeted analysis of organic contaminants in remote environments such as Mount Everest, Mt. Kilimanjaro, and Tibet River. 
The methodology's emphasis on resolving isomers, incorporating retention time into clustering, and assigning molecular formulas aligns with my goal of computationally identifying unknown molecules beyond simple mass-based annotation. 
This work demonstrates how rigorous data preprocessing combined with advanced clustering techniques can improve structural annotation accuracy. 
It is highly relevant for developing robust machine learning assisted molecular networking pipelines in environmental and analytical chemistry contexts.}
}


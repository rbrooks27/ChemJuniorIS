Integrating such deep learning models can enhance our capacity to classify and interpret complex datasets beyond traditional structure assignment, making them a promising tool in the non-targeted analysis of environmental samples in extreme and underexplored locations.}
}

@article{HERBERT,
title = {Chemical interactions with snow: Understanding the behavior and fate of semi-volatile organic compounds in snow},
journal = {Ecotoxicology and Environmental Safety},
volume = {63},
number = {1},
pages = {3-16},
year = {2006},
note = {The Role of High Mountains in the Global Transport of Persistent Organic Pollutants},
issn = {0147-6513},
doi = {https://doi.org/10.1016/j.ecoenv.2005.05.012},
url = {https://www.sciencedirect.com/science/article/pii/S0147651305001314},
author = {B.M.J. Herbert and S. Villa and C.J. Halsall},
keywords = {Arctic, Alpine, Polar, Persistent organic pollutants, Polychlorinated biphenyls},
abstract = {Snow plays an important role in providing atmospherically derived semi-volatile organic compounds (SVOCs) to regions of high latitude and altitude. The accumulated winter snowpack serves as a reservoir for SVOCs, which may then be released to arctic/alpine catchments during seasonal snowmelt or entrained into deeper layers of snow and ice. This paper provides a review of the occurrence of SVOCs in snow, exploring sampling methodologies and field measurements. Furthermore, chemical fate following snowfall and the propensity of SVOCs to undergo revolatilization with snow metamorphosis are examined along with air–snow partitioning and the role of physical parameters such as snow density and snow surface area in controlling vapor-sorbed levels. Snowmelt and firnification processes are described, and the latter are related to SVOC measurements made in deeper snow layers and glacial ice cores. Evidence is provided that suggests that those SVOCs that possess relatively higher snow interfacial/air partitioning coefficients (Kiasnow) or lower Henry's Law constants may be more efficiently retained in snow, with implications for the occurrence of currently used pesticides in the temperate mountain snowpack.},
annote = {This article highlights the importance of understanding the behavior and fate of semi-volatile organic compounds (SVOCs) in snow, particularly in the context of high latitude and altitude regions. The review of sampling methodologies and field measurements provides valuable insights for researchers studying the environmental impact of SVOCs in snow-covered areas.}
}


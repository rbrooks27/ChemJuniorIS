@article{dahmen-levisonMethylbranchedGlycerophosphocholinesMonolayer2000,
  title = {Methyl-Branched Glycerophosphocholines: Monolayer Disorder and Its Effect on the Rate of Phospholipase {{A2}} Catalyzed Hydrolysis},
  volume = {2},
  issn = {1463-9084},
  shorttitle = {Methyl-Branched Glycerophosphocholines},
  abstract = {Phospholipase A2 catalyzes the cleavage of the sn-2 ester bond of phospholipids. Both the capability to bind to the surface of a phospholipid aggregate and the catalytic turnover rate are highly dependent on the physical state and the molecular packing of the aggregated substrate. Methyl-branched glycerophosphocholines (PCs) were studied in order to evaluate the influence of short-chain branching on monolayer packing properties and its effect on the hydrolysis reaction. The diester PCs were cleaved at a higher rate than the plasmalogen-analogue ether\textendash{}ester compounds. Branching in the sn-2 chain has a stronger effect than in the non-cleaved chain. The correlation of the ill-ordered monolayer structure with the reduced reaction yield is discussed.},
  language = {en},
  number = {20},
  journal = {Phys. Chem. Chem. Phys.},

  file = {C:\\Users\\kacar\\Zotero\\storage\\FTEJAS5A\\Wu et al. - 2011 - Transforming binding affinities from three dimensi.pdf;C:\\Users\\kacar\\Zotero\\storage\\JS5RZXRE\\nature10183.html}
}


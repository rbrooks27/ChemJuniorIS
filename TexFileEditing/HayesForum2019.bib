@article{whitfieldMetalBindingHeparin1991,
  title = {Metal Binding to Heparin Monosaccharides: {{D}}-Glucosamine-6-Sulphate, {{D}}-Glucuronic Acid, and {{L}}-Iduronic Acid},
  volume = {41},
  issn = {0162-0134},
  shorttitle = {Metal Binding to Heparin Monosaccharides},
  abstract = {In order to ascertain which residues in heparin may be responsible for its metal binding capacities we have investigated metal binding to some of its component monosaccharides by 1H and 13C NMR. The diamagnetic Zn ion and the paramagnetic Ni ion were used as probes. 4-Methylumbelliferyl-2-deoxy-2-acetamido-6-O-sulpho-D-glucosamine was used as a model for O-sulphates. Only weak interactions with the sulphate group were found. The 4C1 ring conformation of sodium methyl-{$\beta$}-D-glucopyranosiduronate was not perturbed by binding to its carboxylate and little evidence exists for chelation. By contrast, the ring conformation of the sodium methyl-{$\alpha$}-L-idopyranosiduronate is affected by the addition of Zn {$>$} Pb {$>$} Cd {$>$} Ca {$>$} K ions. The sodium salt is suggested to be an equilibrium mixture of the 2So and 1C4 ring conformations. Cation binding to the carboxylate group shifts this equilibrium towards the 1C4 conformation and suggests additional binding to O5 or, less likely, O4. This effect appears to be electrostatic in nature, as excess Na and protonation produce similar shifts. Lead complexation is different from the other ions and suggests some covalent character. The control of the ring conformation of iduronic acid by metal ions may have biological implications for the action of heparin and heparin-like compounds.},
  number = {3},
  journal = {Journal of Inorganic Biochemistry},
  doi = {10.1016/0162-0134(91)80009-7},
  author = {Whitfield, Dennis M. and Sarkar, Bibudhendra},
  month = feb,
  year = {1991},
  pages = {157-170},
  file = {C:\\Users\\kacar\\Zotero\\storage\\C45SAPLR\\Whitfield and Sarkar - 1991 - Metal binding to heparin monosaccharides D-glucos.pdf;C:\\Users\\kacar\\Zotero\\storage\\L25JU5B8\\0162013491800097.html}
}


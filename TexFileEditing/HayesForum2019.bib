  pages = {699-702},
  file = {C:\\Users\\kacar\\Zotero\\storage\\2HZKBH9B\\Rossignol et al. - 2016 - Atmospheric photochemistry at a fatty acid–coated .pdf;C:\\Users\\kacar\\Zotero\\storage\\T3WJ8JR3\\699.html},

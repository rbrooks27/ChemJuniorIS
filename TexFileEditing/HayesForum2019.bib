@article{uematsuTemperatureDependenceMixed1990,
  title = {The Temperature Dependence of Mixed Monolayers of Poly-{$\gamma$}-Methyl-l-Glutamate and Palmitic Acid at the Air/Water Interface},
  volume = {135},
  issn = {0021-9797},
  abstract = {There is a flat region (plateau region) ascribed to the transition from monolayer to bilayer in the surface pressure (F)-area (A) isotherm of poly-{$\gamma$}-methyl-l-glutamate (PMLG) at the air/water interface. The change in entropy from initial to final state of this transition is very small and negative. This indicates that the order in the monolayer and bilayer states is almost the same but that the former is a little more random. At or below 20\textdegree{}C, the monolayer of palmitic acid (PA) forms a solid condensed film and no difference in the F-A isotherm was detected regardless of temperature. However, there is a break at about 16.8\textdegree{}C in the curve of temperature versus surface pressure of the flat region in the F-A isotherm corresponding to the collapse of the PA monolayer. This suggests that the monolayer states of PA above and below 16.8\textdegree{}C are different. PA at or above 20\textdegree{}C is more miscible with PMLG in the monolayer state than PA at or below 15\textdegree{}C. The difference between miscibility of PMLG in the monolayer state and PA at or above 20\textdegree{}C and at or below 15\textdegree{}C can perhaps be ascribed to the difference between the monolayer states of PA above and below ca. 16.8\textdegree{}C.},
  number = {2},
  journal = {Journal of Colloid and Interface Science},
  doi = {10.1016/0021-9797(90)90029-N},
  author = {Uematsu, Shogo and Kimura, Fumiko and Sonoda, Yukihiro and Akahori, Yukio and Nakagaki, Masayuki},
  month = mar,
  year = {1990},
  pages = {580-582},
  file = {C:\\Users\\kacar\\Zotero\\storage\\CLTZHS9W\\Uematsu et al. - 1990 - The temperature dependence of mixed monolayers of .pdf;C:\\Users\\kacar\\Zotero\\storage\\NY6MXKFY\\002197979090029N.html}

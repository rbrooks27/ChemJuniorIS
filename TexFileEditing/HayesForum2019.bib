  file = {C:\\Users\\kacar\\Zotero\\storage\\RCMJSN6S\\Muro et al. - 2012 - Molecular Rearrangement in a Zinc Stearate Langmui.pdf;C:\\Users\\kacar\\Zotero\\storage\\LBYPFAHI\\jp212028d.html}
}

@article{yamamotoMolecularStructuresFree2008,
  title = {Molecular {{Structures}} at {{Free Surfaces}} of {{Liquid}} N-{{Heptadecane Investigated}} by {{Infrared External Reflection Spectroscopy}}},
  volume = {112},
  issn = {1932-7447},
  abstract = {Molecular structures at the free surface of liquid n-heptadecane (n-C17H36; freezing point (Tf) 22 \textdegree{}C, surface freezing point (Ts) 24 \textdegree{}C) were studied by infrared external reflection spectroscopy. Upon successively cooling the liquid sample from 28 \textdegree{}C, at which the sample assumes an isotropic state, to 26, 25, and 24 \textdegree{}C, the infrared external reflection spectra exhibited drastic changes, indicating changes in the orientation and conformation of surface species. At 26 \textdegree{}C, an irregular structure of n-C17H36 with a gauche conformation changes into a regular one with a mainly trans conformation, and simultaneously the symmetry axis of the terminal methyl group tilts away from the surface normal. At 25 \textdegree{}C, the hydrocarbon chain raises its axis to the direction of the surface normal, and the carbon skeleton plane inclines to the direction of the surface plane. At 24 \textdegree{}C (Ts), the molecular axis is raised further to the direction of the surface normal, and the surface species form a rotator phase at the surface. Thus, upon cooling from a temperature a few degrees above Ts, surface freezing of n-C17H36 proceeds through discrete structural and orientation changes of the surface species, contrasting with the explanations of previous studies in terms of an abrupt structural change at the free surface occurring at Ts.},
  number = {34},
  journal = {J. Phys. Chem. C},
  doi = {10.1021/jp801414t},
  author = {Yamamoto, Masato and Suzuki, Masako and Kimura, Tetsuhiro and Itoh, Koichi},
  month = aug,
  year = {2008},
  pages = {13232-13239},
  file = {C:\\Users\\kacar\\Zotero\\storage\\ZSTMX8CK\\Yamamoto et al. - 2008 - Molecular Structures at Free Surfaces of Liquid n-.pdf;C:\\Users\\kacar\\Zotero\\storage\\RERL7R9J\\jp801414t.html}
}


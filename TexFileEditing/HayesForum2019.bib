@article{scheferAnomalousStiffeningIonInduced2015,
  title = {Anomalous {{Stiffening}} and {{Ion}}-{{Induced Coil}}\textendash{{Helix Transition}} of {{Carrageenans}} under {{Monovalent Salt Conditions}}},
  volume = {16},
  issn = {1525-7797},
  abstract = {The macromolecular conformations of anionic polysaccharides with decreasing linear charge densities - lambda, iota, and kappa carrageenan -, at varying NaCl concentrations, are studied by single-chain statistical analysis of high-resolution atomic force microscopy (AFM) images. Lambda remains in the random coil conformation, whereas iota and kappa undergo ion-induced coil\textendash{}helix transitions, with a 2\textendash{}3-fold increase in chain rigidity. At low ionic strengths, I, the polymer chains sequester Na+, leading to a greater flexibility, and beyond a critical I to the formation of an intramolecular single helix. The persistence length exhibits a sublinear dependence on the Debye screening length, {$\kappa$}\textendash{}1, Lpe {$\sim$} {$\kappa$}\textendash{}y (with 0 {$<$} y {$<$} 1), deviating from the classical polyelectrolyte behavior expressed by Odijk\textendash{}Skolnick\textendash{}Fixman or Barrat\textendash{}Joanny models. Above a certain I, the Lp shows an upturn, resulting in polymer stiffening and nonmonotonic behavior. This phenomenon is inferred from specific ion\textendash{}polymer interactions and/or nonlinear electrostatic physics involving ion\textendash{}ion correlations.},
  number = {3},
  journal = {Biomacromolecules},
  doi = {10.1021/bm501874k},
  author = {Schefer, Larissa and Usov, Ivan and Mezzenga, Raffaele},
  month = mar,
  year = {2015},
  pages = {985-991},
  file = {C:\\Users\\kacar\\Zotero\\storage\\A879A972\\Schefer et al. - 2015 - Anomalous Stiffening and Ion-Induced Coil–Helix Tr.pdf;C:\\Users\\kacar\\Zotero\\storage\\UN74JI7V\\bm501874k.html}
}

@article{takemasaCounterionDynamicsICarrageenan2002,
  title = {Counterion {{Dynamics}} of {$\kappa$}- and {$\iota$}-{{Carrageenan Aqueous Solutions Investigated}} by the {{Dielectric Properties}}},
  volume = {35},
  issn = {0024-9297},
  abstract = {The temperature dependence of the dielectric properties of {$\kappa$}- and {$\iota$}-carrageenan aqueous solutions with various counterion species, K, Ca, and Na, were investigated over the frequency range 10-2-106 Hz and the temperature range 2.0-80.0 \textdegree{}C. In the case of {$\kappa$}-carrageenan solutions, just below the coil-to-helix transition temperature, TCH, the dc conductivity sharply decreases within a few degrees of temperature. In contrast, the sharp decrease was not observed for {$\iota$}-carrageenan solutions. The dielectric relaxation process with the relaxation time {$\sim$}100 {$\mu$}s, which can be assigned to the counterion fluctuation in the parallel direction to the helical axis, arises below TCH. Just below TCH, the relaxation strength increases sharply with decreasing temperature for both the carrageenan type with all the counterion species exhibiting the coil-to-helix transition, reaching {$\sim$}103 at the temperatures far below TCH. These findings indicate that the counterions are tightly bound to helical molecules due to an increase of the charge density along the helical axis during the coil-helix transition. The relaxation time reflecting the fluctuation distance increases sharply in the initial stage of gelation and gradually reaches a constant value. We think that the formation of the high charge density region, which is connected with the aggregated region of helices, is determined by which process, a growth of the length of the helices or the aggregation of the helices, precedes in the initial stage of gelation.},
  number = {14},
  journal = {Macromolecules},
  doi = {10.1021/ma020206f},
  author = {Takemasa, Makoto and Chiba, Akio and Date, Munehiro},
  month = jul,
  year = {2002},
  pages = {5595-5600},
  file = {C:\\Users\\kacar\\Zotero\\storage\\4B3JPJWF\\Takemasa et al. - 2002 - Counterion Dynamics of κ- and ι-Carrageenan Aqueou.pdf;C:\\Users\\kacar\\Zotero\\storage\\3DT887NA\\ma020206f.html}
}

@article{janaswamyCationinducedPolymorphismIotacarrageenan2005,
  title = {Cation-Induced Polymorphism in Iota-Carrageenan},
  volume = {60},
  issn = {0144-8617},
  abstract = {Recent X-ray fiber diffraction patterns from polycrystalline and well-oriented fibers of calcium, rubidium and potassium salt forms of {$\iota$}-carrageenan correspond to large trigonal unit cells. In contrast to the previously reported sodium and calcium forms that contain three half-staggered double helices, these new unit cells accommodate 4, 16 and 27 double helices, respectively. Interestingly, their basal net dimensions ranging from 23.6 to 68.2{\AA} can all be generated from the smallest trigonal lattice having cell edge 13.7{\AA}. The peripheral sulfate groups on the prism shaped {$\iota$}-carrageenan helix, along with cations and water molecules, are mainly responsible for the association of helices. The existence of several cation-dependent stable crystalline states is compatible with the observed versatility in the physical properties of {$\iota$}-carrageenan.},
  number = {4},
  journal = {Carbohydrate Polymers},
  doi = {10.1016/j.carbpol.2005.03.013},
  author = {Janaswamy, Srinivas and Chandrasekaran, Rengaswami},
  month = jun,
  year = {2005},
  keywords = {Junction zone,Carrageenan,Packing,Polymorphism,Sulfated polysaccharides},
  pages = {499-505},
  file = {C:\\Users\\kacar\\Zotero\\storage\\F4RN6VEV\\Janaswamy and Chandrasekaran - 2005 - Cation-induced polymorphism in iota-carrageenan.pdf;C:\\Users\\kacar\\Zotero\\storage\\6PSJHMW3\\S0144861705001025.html}
}

@article{janaswamySodiumICarrageenanParadigm2006,
  title = {Sodium {$\iota$}-{{Carrageenan}}:\, {{A Paradigm}} of {{Polymorphism}} and {{Pseudopolymorphism}}},
  volume = {39},
  issn = {0024-9297},
  shorttitle = {Sodium {$\iota$}-{{Carrageenan}}},
  abstract = {X-ray fiber diffraction patterns of the sodium salt of {$\iota$}-carrageenan correspond to three (I, II, and III) distinct packing arrangements of half-staggered, 3-fold, double helices having nearly the same helical repeat (c-axis 13.0-13.2 {\AA}). While two of the three forms crystallize in trigonal nets with a = 24.02 for I and 21.8 {\AA} for III, II favors an orthogonal net with a = 13.70 and b = 20.08 {\AA}. Detailed structure analysis of I has shown that three helices in the unit cell, each pair at 13.9 {\AA} apart, interact only through their 2-sulfate and 4-sulfate groups with the aid of sodium ions and ordered water molecules [Janaswamy, S.; Chandrasekaran, R. Carbohydr. Res. 2001, 335, 181-194]. The ability of sodium to induce two other crystalline structures, in which the helix-helix separations are considerably shorter (12.2 in II and 12.6 {\AA} in III), suggests that interhelical interactions vary significantly among the polymorphs. These observations have ramifications to the practical applications of {$\iota$}-carrageenan in food and pharmaceutical industries.},
  number = {9},
  journal = {Macromolecules},
  doi = {10.1021/ma060024b},
  author = {Janaswamy, Srinivas and Chandrasekaran, Rengaswami},
  month = may,
  year = {2006},
  pages = {3345-3349},
  file = {C:\\Users\\kacar\\Zotero\\storage\\RK7RGGM3\\Janaswamy and Chandrasekaran - 2006 - Sodium ι-Carrageenan  A Paradigm of Polymorphism .pdf;C:\\Users\\kacar\\Zotero\\storage\\UITKR3EC\\ma060024b.html}
}


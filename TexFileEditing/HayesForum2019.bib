  file = {C:\\Users\\kacar\\Zotero\\storage\\CKRNGTZR\\Gelder et al. - Reference database of Raman spectra of biological .pdf;C:\\Users\\kacar\\Zotero\\storage\\7QI4IB3A\\jrs.html}

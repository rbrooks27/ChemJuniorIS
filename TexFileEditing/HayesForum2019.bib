}

@article{CommunicationVibrationalSumfrequency2016,
  title = {Communication: {{Vibrational}} Sum-Frequency Spectrum of the Air-Water Interface, Revisited},
  volume = {145},
  issn = {0021-9606},
  shorttitle = {Communication},
  abstract = {Before 2015, heterodyne-detected sum-frequency-generation experiments on the air-water interface showed the presence of a positive feature at low frequency in the imaginary part of the susceptibility. However, three very recent experiments indicate that this positive feature is in fact absent. Armed with a better understanding, developed by others, of how to calculate sum-frequency spectra, we recalculate the spectrum and find good agreement with these new experiments. In addition, we provide a revised interpretation of the spectrum.},

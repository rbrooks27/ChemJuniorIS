}

@article{albrechtDissolutionMyristicAcid1999,
  title = {The Dissolution of Myristic Acid Monolayers in Water},
  volume = {338},
  issn = {0040-6090},
  abstract = {The measurement of surface pressure\textendash{}area isotherms of short chain fatty acids on a Langmuir trough often shows irreproducible, large errors, in spite of high purity of materials, cleanliness of equipment and sophistication of routines. By controlling the timing during monolayer spreading, the spreading speed and the history and age of the subphase, these errors become systematic and reproducible. On the basis of myristic acid, where the effect is very large, and palmitic acid, for which the effect is far from negligible, it is shown that the governing effect is dissolution and saturation of the molecules in the subphase. This raises the question of metastability of such monolayers not only above the equilibrium spreading pressure but at any pressure. It also explains some, so far, ill-understood problems about Langmuir\textendash{}Blodgett film fabrication and the measurement of equilibrium spreading pressures.},
  number = {1},
  journal = {Thin Solid Films},
  doi = {10.1016/S0040-6090(98)00998-5},
  author = {Albrecht, O and Matsuda, H and Eguchi, K and Nakagiri, T},
  month = jan,
  year = {1999},
  keywords = {Langmuir–Blodgett films,Monolayers,Carboxylic acids,Surface thermodynamics},
  pages = {252-264},
  file = {C:\\Users\\kacar\\Zotero\\storage\\T4C9PSH9\\Albrecht et al. - 1999 - The dissolution of myristic acid monolayers in wat.pdf;C:\\Users\\kacar\\Zotero\\storage\\3V34YRSQ\\S0040609098009985.html}
}

@article{khattariInterfacialBehaviorMyristic2017,
  title = {Interfacial Behavior of {{Myristic}} Acid in Mixtures with {{DMPC}} and {{Cholesterol}}},
  volume = {490},
  issn = {0301-0104},
  abstract = {Binary mixture monolayers of Myristic acid (MA) with the same length of saturated acyl chain lipid viz 1,2-myristoyl-sn-glycero-3-phosphocholine (DMPC) and Cholesterol (Chol), were investigated under different experimental conditions using Langmuir monolayers (LMs). The interfacial pressure-area ({$\pi$}-A) isotherms, excess molecular area, excess free energy and fluorescence microscopy (FM) images were recorded at the air/water interface. Monolayers of both systems (e.g. MA/DMPC, MA/Chol) reach the closest acyl hydrophobic chain packing in the range 0.20{$<$}xMA{$<$}0.70. Thermodynamic analysis indicates miscibility of the binary mixtures when spread at the air/water interface with negative deviation from the ideal behavior. Morphological features of MA/DMPC systems were found to depend strongly on MA mole fraction and pressures by showing two extreme minima in Gibbs free energy of mixing, while MA/Chol systems showed only an effective condensing effect at xMA=0.90. In the whole range of compositions studied here, the liquid-expanded (LE) to liquid-condensed (LC) phase transition occurs at increasing xAM as it accomplished by a huge increase in the inverse compressibility modulus. FM observations confirmed the phase-transition and condensing effects of both mixture monolayers as evidenced by Gibbs free energy of mixing in a limited range of compositions.},
  journal = {Chemical Physics},
  doi = {10.1016/j.chemphys.2017.04.012},
  author = {Khattari, Z. and Sayyed, M. I. and Qashou, S. I. and Fasfous, I. and {Al-Abdullah}, T. and Maghrabi, M.},
  month = jun,
  year = {2017},
  keywords = {Langmuir monolayer,Miscibility,Condensing effect,Fatty acids,Fluorescence microscopy,Phospholipids},
  pages = {106-114},
  file = {C:\\Users\\kacar\\Zotero\\storage\\WAPJ7LHW\\Khattari et al. - 2017 - Interfacial behavior of Myristic acid in mixtures .pdf;C:\\Users\\kacar\\Zotero\\storage\\MZDT5XI6\\S0301010416307935.html}
}


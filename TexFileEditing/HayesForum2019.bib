@article{yoonSeasonalCharacteristicsPhysicochemical2007,
  title = {Seasonal Characteristics of the Physicochemical Properties of {{North Atlantic}} Marine Atmospheric Aerosols},
  volume = {112},
  issn = {2156-2202},
  abstract = {Seasonal physicochemical characteristics of North Atlantic marine aerosols are presented for the period from January 2002 to June 2004. The aerosol size distribution modal diameters show seasonal variations, 0.031 {$\mu$}m in winter and 0.049 {$\mu$}m in summer for the Aitken mode and 0.103 {$\mu$}m in winter and 0.177 {$\mu$}m in summer for the accumulation mode. The accumulation mode mass also showed a seasonal variation, minimum in winter and maximum in summer. A supermicron sized particle mode was found at 2 {$\mu$}m for all seasons showing 30\% higher mass concentration during winter than summer resulting from higher wind speed conditions. Chemical analysis showed that the concentration of sea salt has a seasonal pattern, minimum in summer and maximum in winter because of a dependency of sea-salt load on wind speeds. By contrast, the non-sea-salt (nss) sulphate concentration in fine mode particles exhibited lower values during winter and higher values during midsummer. The water soluble organic carbon (WSOC) and total carbon (TC) analysis also showed a distinctive seasonal pattern. The WSOC concentration during the high biological activity period peaked at 0.2 {$\mu$}gC m-3, while it was lower than 0.05 {$\mu$}gC m-3 during the low biological activity period. The aerosol light scattering coefficient showed a minimum value of 5.5 Mm-1 in August and a maximum of 21 Mm-1 in February. This seasonal variation was due to the higher contribution of sea salt in the MBL during North Atlantic winter. By contrast, aerosols during late spring and summer exhibited larger angstrom parameters than winter, indicating a large contribution of the biogenically driven fine or accumulation modes. Seasonal characteristics of North Atlantic marine aerosols suggest an important link between marine aerosols and biological activity through primary production of marine aerosols.},
  language = {en},
  number = {D4},
  journal = {J. Geophys. Res.},
  doi = {10.1029/2005JD007044},
  author = {Yoon, Y. J. and Ceburnis, D. and Cavalli, F. and Jourdan, O. and Putaud, J. P. and Facchini, M. C. and Decesari, S. and Fuzzi, S. and Sellegri, K. and Jennings, S. G. and O'Dowd, C. D.},
  month = feb,
  year = {2007},
  keywords = {0305 Aerosols and particles,3311 Clouds and aerosols,0315 Biosphere/atmosphere interactions,aerosol primary production,marine aerosol,seasonal variation},
  pages = {D04206},
  file = {C:\\Users\\kacar\\Zotero\\storage\\QKXWWTQI\\Yoon et al. - 2007 - Seasonal characteristics of the physicochemical pr.pdf;C:\\Users\\kacar\\Zotero\\storage\\S7A4DAWN\\abstract.html}
}

@article{lovricWaterInducedOrganizationPalmitic2016,
  title = {Water-{{Induced Organization}} of {{Palmitic Acid}} at the {{Surface}} of a {{Model Sea Salt Particle}}: {{A Molecular Dynamics Study}}},
  volume = {120},
  issn = {1089-5639},
  shorttitle = {Water-{{Induced Organization}} of {{Palmitic Acid}} at the {{Surface}} of a {{Model Sea Salt Particle}}},
  abstract = {Marine aerosols represent the most important aerosol fraction in the Earth atmosphere. Field studies have revealed that fatty acids form an organic film at the surface of sea salt particles, altering the properties of the aerosol. By means of classical molecular dynamics simulation, the surface organization of palmitic acid (PA) on a salt surface, NaCl, has been investigated at two different temperatures, 235 and 300 K, and with relative humidity varying from 0 to 40\%. Calculations show that water promotes the formation of well-ordered close-packed PA islands. As a result, some area of the salt may be covered by water only or by PA molecules supported by water. Depending on the relative humidity, the hydrophilic/hydrophobic character of the sea salt surface varies. This heterogeneous coating gives rise locally to very different surface properties and hence may affect the transfer of gas phase species to the salt and their reactivity.},
  number = {51},
  journal = {J. Phys. Chem. A},
  doi = {10.1021/acs.jpca.6b07792},
  author = {Lovri{\'c}, Josip and Duflot, Denis and Monnerville, Maurice and Toubin, C{\'e}line and Briquez, St{\'e}phane},
  month = dec,
  year = {2016},
  pages = {10141-10149},
  file = {C:\\Users\\kacar\\Zotero\\storage\\I9I8NC8P\\Lovrić et al. - 2016 - Water-Induced Organization of Palmitic Acid at the.pdf;C:\\Users\\kacar\\Zotero\\storage\\QAIUUW8M\\acs.jpca.html}
}


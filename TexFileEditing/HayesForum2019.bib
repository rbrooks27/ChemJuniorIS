  month = aug,
  year = {2015},
  pages = {3519-3526},
  file = {C:\\Users\\kacar\\Zotero\\storage\\7IR48VUZ\\Abdelmonem et al. - 2015 - Probing ice-nucleation processes on the molecular .pdf;C:\\Users\\kacar\\Zotero\\storage\\6EP8ZIKV\\2015.html}
}


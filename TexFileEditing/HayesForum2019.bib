@misc{sudheeshHysteresisIsothermsMixed2012,
  type = {Research Article},
  title = {Hysteresis of {{Isotherms}} of {{Mixed Monolayers}} of {{N}}-{{Octadecyl}}-{{N}}\&\#x2032;-Phenylthiourea and {{Stearic Acid}} at {{Air}}/{{Water Interface}}},
  abstract = {Surface pressure area isotherms of Langmuir monolayers formed by spreading mixed solutions of varying concentrations of N-octadecyl-N{${'}$}-phenylthiourea (OPT) and octadecanoic acid or stearic acid (SA) over air-water interface are described. Examination of the hysteresis behavior and an analysis of the limiting area per molecule of the isotherms show that when the spread solution has an excess of OPT, the limiting surface area is consistent with a monolayer composed of equimolar amounts of the two components. This indicates that any excess thiourea, which on its own does not form a stable monolayer, is squeezed out and is not part of the monolayer. On the other hand, when the spreading mixture has an excess of SA over OPT, the isotherm indicates that the entire originally spread material is incorporated into the surface film. In this case, the values of area/molecule indicate that the monolayer is composed of SA\,:\,OPT complex with a ratio of 1\,:\,1 together with the excess SA remaining in the monolayer.},
  language = {en},
  journal = {International Scholarly Research Notices},
  howpublished = {https://www.hindawi.com/journals/isrn/2012/835397/},
  author = {Sudheesh, Siji and Ahmad, Jamil and Singh, Girija S.},
  year = {2012},
  file = {C:\\Users\\kacar\\Zotero\\storage\\5CDEB8IX\\Sudheesh et al. - 2012 - Hysteresis of Isotherms of Mixed Monolayers of N-O.pdf;C:\\Users\\kacar\\Zotero\\storage\\VWU2RMEM\\835397.html},
  doi = {10.5402/2012/835397}
}

@article{mundenSurfacePressureRelaxation1969,
  title = {Surface Pressure Relaxation and Hysteresis in Stearic Acid Monolayers at the Air-Water Interface},
  volume = {58},
  issn = {1520-6017},
  abstract = {Time-dependent changes in the surface pressure of stearic acid monolayers were examined using an automated Wilhelmy-type film balance. Different surface pressure-area isotherms were obtained for two different rates of compression. Pressure relaxation from preselected surface pressures was examined as a function of time. The results indicated two types of relaxation which, along with the compression rate effect, may be rationalized on the basis of changes in molecular orientation and redistribution, together with expulsion from the monolayer at areas below the limiting area per molecule. Marked hysteresis effects were also noted when stearic acid monolayers were subjected to compression expansion cycles. The effect of repeated cycling and the minimum area of compression on hysteresis were investigated. The onset and extent of hysteresis may also be explained on the basis of expulsion and reentry and orientation and redistribution of molecules at the interface.},
  language = {en},
  number = {11},
  journal = {J. Pharm. Sci.},
  doi = {10.1002/jps.2600581103},
  author = {Munden, James W. and Blois, David W. and Swarbrick, James},
  month = nov,
  year = {1969},
  keywords = {Air-water interface—Surface pressure,Hysteresis—effect of minimum area of compression Cycling; requested; effect—hysteresis,Keyphrases Stearic acid monomolecular films-effect of compression rate,Surface pressure relaxation—stearic acid monolayers},
  pages = {1308-1312},
  file = {C:\\Users\\kacar\\Zotero\\storage\\G83SJ25Q\\Munden et al. - 1969 - Surface pressure relaxation and hysteresis in stea.pdf;C:\\Users\\kacar\\Zotero\\storage\\7QS8ZSJZ\\abstract.html}
}

@article{quastUseZetaPotential2016,
  title = {The Use of Zeta Potential to Investigate the {{pKa}} of Saturated Fatty Acids},
  volume = {27},
  issn = {0921-8831},
  abstract = {Reported values for the acid dissociation constant (pKa) of the saturated fatty acids show a wide range, depending on their method of measurement. Although the pKa values of the shorter chain saturated fatty acids are generally recognised to be approximately 4.5\textendash{}5.0, pKa values for the longer chain fatty acids have been reported to be much higher, up to pH 10. It is the purpose of this study to investigate the values of pKa measured using microelectrophoresis for saturated fatty acids with chain lengths between C10 and C18. This returned an average pKa value of 4.0 for these saturated fatty acids. By the method of measurement, this value should be considered as the surface pKa value as opposed to bulk pKa values. The graphs of mobility vs. pH showed isoelectric points between 2 and 3, with the existence of positive surfaces on the particles of fatty acids confirmed. Some examples of the relevance of pKa values for saturated fatty acids in the flotation of non-sulphide minerals have also been given.},
  number = {1},
  journal = {Advanced Powder Technology},
  doi = {10.1016/j.apt.2015.12.003},
  author = {Quast, Keith},
  month = jan,
  year = {2016},
  keywords = {Dissociation constant,Isoelectric point,Saturated fatty acids,Surface pa},
  pages = {207-214},
  file = {C:\\Users\\kacar\\Zotero\\storage\\9EEMB8E2\\Quast - 2016 - The use of zeta potential to investigate the pKa o.pdf;C:\\Users\\kacar\\Zotero\\storage\\P7XEIXTS\\S0921883115002666.html}
}

@article{brzozowskaStabilityInteractionsMixed2013,
  title = {Stability and Interactions in Mixed Monolayers of Fatty Acid Derivatives on {{Artificial Sea Water}}},
  volume = {433},
  issn = {0927-7757},
  abstract = {We studied the formation and stability of fatty acid and derivatives films on aqueous sub-phases by means of Langmuir trough experiments. Films were prepared from pure stearic acid (SA), stearyl amine (SAm) and 12-phenyldodecanoic acid (PDA), and from binary systems of SA with either SAm or PDA. For the aqueous sub-phase, multicomponent salt solutions (`Artificial Sea Water') at various concentrations (cASW, 0\textendash{}100\%) and pH values (3\textendash{}7) were explored. SAm and SA differ most strongly at pH 7, where they can dissociate into oppositely charged species. For SA:SAm mixtures at this pH, pressure-area isotherms indicate mixing on a molecular scale. Increase of salt concentration from 0.05 to 0.5M causes significant contraction of the layer, which is ascribed to (enhanced) electrostatic attractions between the head-groups. Relaxation experiments with these films indicate that dissolution of SAm into the sub-phase is suppressed by SA. The most stable films are formed at xSA=0.5, in agreement with the calculated excess free energy of mixing. PDA is much less amphiphilic than SA. (Meta-) stable mixed films of SA and PDA are formed only at high salt concentration and low pH, where the solubility of PDA into the sub-phase is the lowest. Under these conditions, SA appears to have a stabilizing effect, which is however not strong enough to prevent expulsion of PDA from interface. Isobars of SA:PDA films corroborate this picture. The weak interactions between SA and PDA are confirmed by the excess free energies of mixing, which are close to those of ideal mixtures.},
  journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
  doi = {10.1016/j.colsurfa.2013.04.062},
  author = {Brzozowska, A. M. and Mugele, F. and Duits, M. H. G.},
  month = sep,
  year = {2013},
  keywords = {12-Phenyldodecanoic acid,Artificial Sea Water,Excess mixing area,Langmuir trough,Monolayer stability,Stearic acid,Stearyl amine},
  pages = {200-211},
  file = {C:\\Users\\kacar\\Zotero\\storage\\8R5P4F7X\\Brzozowska et al. - 2013 - Stability and interactions in mixed monolayers of .pdf;C:\\Users\\kacar\\Zotero\\storage\\568ACGVD\\S0927775713003749.html}
}

@article{brzozowskaStabilityStearicAcid2012,
  title = {Stability of Stearic Acid Monolayers on {{Artificial Sea Water}}},
  volume = {407},
  issn = {0927-7757},
  abstract = {We studied the formation and stability of stearic acid (SA) based films on aqueous sub-phases via Langmuir trough and imaging ellipsometry experiments. The aqueous phase was based on Artificial Sea Water (ASW), a multicomponent salt solution with a total molarity of 0.53. The composition of this solution was varied via dilution (1, 10 and 100 times) and adjustment of the pH (3, 7, 10). Also water sub-phases without the ASW salts were studied. Pressure\textendash{}area isotherms of the SA monolayers show an enhanced stability of the film against fracture when the pH and/or the salt concentration of the sub-phase are increased. Isobars of SA measured below the pressure needed for film fracture, indicate distinct mechanisms for loss of material: (1) at low pH and salt concentration, three dimensional (3D) structures are formed at the air/water interface via nucleation and growth and (2) at high pH and salt concentration, diffusion-controlled dissolution of molecules in the sub-phase occurs. The formation of multilayer structures was corroborated with ellipsometry images of the films after Langmuir\textendash{}Blodgett transfer.},
  journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
  doi = {10.1016/j.colsurfa.2012.04.055},
  author = {Brzozowska, A. M. and Duits, M. H. G. and Mugele, F.},
  month = aug,
  year = {2012},
  keywords = {Artificial Sea Water,Langmuir trough,Monolayer stability,Stearic acid,Imaging ellipsometry},
  pages = {38-48},
  file = {C:\\Users\\kacar\\Zotero\\storage\\HSPHBH4V\\StearicAcidStability_ASW_ColloidsSurfacesA2012.pdf;C:\\Users\\kacar\\Zotero\\storage\\KTNK6SV9\\Brzozowska et al. - 2012 - Stability of stearic acid monolayers on Artificial.pdf;C:\\Users\\kacar\\Zotero\\storage\\WBURXQFG\\S0927775712003214.html}
}


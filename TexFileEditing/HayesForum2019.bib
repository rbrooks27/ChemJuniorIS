  pages = {4857-4865},
  file = {C:\\Users\\kacar\\Zotero\\storage\\AT8KRIPM\\Mao et al. - 2013 - Oleic Acid Disorders Stratum Corneum Lipids in Lan.pdf;C:\\Users\\kacar\\Zotero\\storage\\44RM6XHR\\la4002384.html}
}


  title = {Polysaccharides from {{{\emph{Enteromorpha}}}}{\emph{ Compressa}}: {{Isolation}}, Purification and Structural Features},
  volume = {66},
  issn = {0144-8617},
  shorttitle = {Polysaccharides from {{Enteromorpha}} Compressa},
  abstract = {Polysaccharides containing fractions were obtained from the seaweed Enteromorpha compressa by sequential extractions with various solvents. Anion exchange chromatography (AEC) of the oxalate extracted fraction (OSP) yielded rhamnoxylogalactoglucuronan, xyloglucan and glucuronan rich sub-fractions. The heteroglycuronan, which is sulfated, has an apparent molecular mass of 50{$\pm$}20kDa and is soluble in water. Methylation analysis of the native, desulfated and desulfated reduced heteroglycuronan sulfate suggested that this polymer is branched and contains, inter alia, (1\textrightarrow4)- and (1\textrightarrow 2,4)-linked-rhamnopyranosyl, (1\textrightarrow4)-linked xylopyranosyl, and (1\textrightarrow4)- and terminally linked glucuronosyl residues. Sulfate groups, when present, are located at C-3 of (1\textrightarrow4)-linked rhamnose units and C-2 of (1\textrightarrow4)-linked xylose units. Degradation of the xyloglucan rich extract (Ec1OH) by endo-(1\textrightarrow4)-{$\beta$}-d-glucanase and analysis of the resulting fragments by matrix-assisted laser desorption ionization-time of flight-mass spectrometry (MALDI-TOF-MS) showed that the E. compressa xyloglucan contains Glc3Xyl1, Glc4, Glc3Xyl2(SO3Na)2, Glc4Xyl2(SO3Na)2 and Glc5Xyl2(SO3Na)2 as major oligomeric building sub-units.},
  number = {3},
  journal = {Carbohydrate Polymers},
  doi = {10.1016/j.carbpol.2006.03.027},
  author = {Ray, Bimalendu},
  month = nov,
  year = {2006},
  keywords = {Enzyme hydrolysis,Glucuronan,Linkage analysis,MALDI-TOF-MS,Molecular mass,Oligosaccharides,Sulfated heteroglycuronan,Xyloglucan sulfate},
  pages = {408-416},
  file = {C:\\Users\\kacar\\Zotero\\storage\\2T2V6EDC\\Ray - 2006 - Polysaccharides from Enteromorpha compressa Isola.pdf;C:\\Users\\kacar\\Zotero\\storage\\8RH8MGSH\\S0144861706001597.html}

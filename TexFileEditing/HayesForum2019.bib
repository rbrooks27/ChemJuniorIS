  file = {C:\\Users\\kacar\\Zotero\\storage\\MRUJ3D93\\Goto et al. - 2011 - Monolayer Collapse Regulating Process of Adsorptio.pdf;C:\\Users\\kacar\\Zotero\\storage\\QL2P5L28\\la104822r.html}
}


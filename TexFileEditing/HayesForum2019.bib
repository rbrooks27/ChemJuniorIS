@article{renMonodispersedTwodimensionalNanoclusters2000,
  title = {Monodispersed Two-Dimensional Nanoclusters of {{CF3}}({{CF2}})3({{CH2}}){{22COOH}} on the Aqueous {{Cd2}}+ Subphase Investigated by Polarization Modulation Infrared Spectroscopy},
  volume = {332},
  issn = {0009-2614},
  abstract = {Polarization modulation infrared reflection absorption spectroscopy was applied to investigate two-dimensional nanoclusters of CF3(CF2)3(CH2)22COOH (C27F9) on the aqueous Cd2+ subphase in a Langmuir trough at 288 K. The \textendash{}(CH2)22\textendash{} long axis was always inclined on the subphase and had triclinic parallel packing with compression from 0.60 to 0.30 nm2. In contrast, behenic acid, without the CF3(CF2)3\textendash{} tail, formed orthorhombic micrometer domains on the Cd2+ subphase with its hydrocarbon chain vertically aligned. It is concluded that the steric hindrance imposed by the bulky CF3(CF2)3\textendash{} tail is responsible for the specific orientation and packing of the \textendash{}(CH2)22\textendash{} part as well as the formation of the nanometer-size clusters.},

  author = {{P{\'e}rez-Morales}, Marta and Pedrosa, Jos{\'e} M. and Mu{\~n}oz, Eulogia and {Mart{\'i}n-Romero}, Mar{\'i}a T. and M{\"o}bius, Dietmar and Camacho, Luis},
  month = sep,
  year = {2005},
  keywords = {Air–water interface,Ellipsometry,Brewster angle microscopy,Monolayers},
  pages = {247-253},
  file = {C:\\Users\\kacar\\Zotero\\storage\\DUKVDVIL\\Pérez-Morales et al. - 2005 - Ellipsometric study of a phospholipid monolayer at.pdf;C:\\Users\\kacar\\Zotero\\storage\\TIY5WYL9\\S0040609005004293.html}
}

@article{muthEllipsometricStudyMolecular2016,
  title = {Ellipsometric Study of Molecular Orientations of {{Thermomyces}} Lanuginosus Lipase at the Air\textendash{}Water Interface by Simultaneous Determination of Refractive Index and Thickness},
  volume = {140},
  issn = {0927-7765},
  abstract = {Ellipsometric studies of very thin organic films suffer from the low refractive index contrast between layer and bulk substrate. We demonstrate that null ellipsometry can not only provide detailed information about the adsorption kinetics and surface excess values, but in addition on layer thicknesses with submonolayer resolution of a lipase from Thermomyces lanuginosus at the air\textendash{}water interface. While measuring very close to the Brewster angle, refractive indices and layer-thicknesses can both be determined with a precision that is sufficiently high to make conclusions on the density and orientation of the molecules at the interface. The orientation was found to be concentration- and pH value-dependent. At the isoelectric point, the lipase was almost vertically oriented with respect to the surface, while for pure distilled water and low lipase concentration a rather horizontal alignment was found. Further experiments, varying the size of the interfacial area in a Langmuir trough, confirm the different layer structures.},
  journal = {Colloids and Surfaces B: Biointerfaces},
  doi = {10.1016/j.colsurfb.2015.12.024},
  author = {Muth, Marco and Schmid, Reiner P. and Schnitzlein, Klaus},

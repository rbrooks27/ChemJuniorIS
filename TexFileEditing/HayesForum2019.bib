@article{gershfeldLiquidCondensedLiquid1982,
  title = {The Liquid Condensed/Liquid Expanded Transition in Lipid Films: {{A}} Critical Analysis of the Film Balance Experiment},
  volume = {85},
  issn = {0021-9797},
  shorttitle = {The Liquid Condensed/Liquid Expanded Transition in Lipid Films},
  abstract = {Studies of the liquid condensed LC)/liquid expanded LE) transition in lipid films, first reported in 1920, have suffered from uncertainty regarding its physical basis even though the transition is usually accepted as a well-defined phenomenon. Since this transition has only been observed with the film balance, one must examine the assumptions which form the basis of the film balance experiment. These assumptions are: a) that the use of solvent to form the films does not impart any properties to the film; b) that the films are stable because they are insoluble in the underlying bulk phase; and c) that ``closed'' films spread on the surface are equivalent to ``open'' films adsorbed from a bulk phase. Tests of these assumptions were applied to films of dimyristoyl phosphatidylcholine DMPC) and palmitic acid, both of which have been reported to undergo the LCLE transition. Violations of these assumptions were found and are shown to lead to incorrect interpretation of the LCLE transitions in spread films. Experimental results indicate: (1) the DMPC transition is caused by the use of spreading solvents; under equilibrium conditions DMPC does not even form the LC state. (2) Spread films are stable not because they are insoluble, but because of an energy barrier for film dissolution; film densities are therefore greater than observed with equilibrium systems. (3) Use of spread films is inappropriate for studying the thermodynamic properties of the LCLE transition.},
  number = {1},
  journal = {Journal of Colloid and Interface Science},
  doi = {10.1016/0021-9797(82)90232-6},
  author = {Gershfeld, Norman L},
  month = jan,
  year = {1982},
  pages = {28-40},
  file = {C:\\Users\\kacar\\Zotero\\storage\\J6E5UIMM\\Gershfeld - 1982 - The liquid condensedliquid expanded transition in.pdf;C:\\Users\\kacar\\Zotero\\storage\\UK5NFPPC\\0021979782902326.html}
}

@article{bishopMonolayerPropertiesChloroplast1980,
  title = {Monolayer Properties of Chloroplast Lipids},
  volume = {602},
  issn = {0005-2736},
  abstract = {The properties of seven monogalactosyldiacylglycerols and six digalactosyldiacylglycerols, isolated from photosynthetic membranes and possessing different levels of fatty acid unsaturation, have been studied by the monolayer technique and compared with those of the fully saturated compounds. In addition, the monolayer properties of sulphoquinovosyldiacylglycerols and phosphatidylglycerols from higher plant chloroplasts, and several hexadecenoic acids have been measured. Monogalactosyldiacylglycerols containing saturated fatty acids form a condensed monolayer similar to that of saturated phosphatidylcholines. The naturally occurring monogalactosyldiacylglycerols, of which the double bond index ranged from 0.6 to 3.9, possessed comparable force-area curves suggesting that headgroup interactions play a more important role in packing behaviour than in phosphatidylcholines. Although digalactosyldiacylglycerols containing fully saturated fatty acids form a more expanded monolayer than the corresponding monogalactosyldiacylglycerols, the degree of expansion of the monolayer due to the presence of unsaturated fatty acids in the naturally occurring digalactosyldiacylglycerols is much less than in monogalactosyldiacylglycerols. Monogalactosyldiacylglycerols and digalactosyldiacylglycerols from a single species have very similar monolayer properties, and the presence of sulphoquinovosyldiacylglycerols and phosphatidylglycerols in the proportions in which they occur in higher plant chloroplasts does not have any condensing effect on a monolayer of galactolipids},
  number = {2},
  journal = {Biochimica et Biophysica Acta (BBA) - Biomembranes},
  doi = {10.1016/0005-2736(80)90308-9},
  author = {Bishop, David G. and Kenrick, Janette R. and Bayston, James H. and Macpherson, Athol S. and Johns, Stanley R.},
  month = nov,
  year = {1980},
  keywords = {Fatty acid,(Thylakoid membrane),Galactosyldiacylglycerol,Photosynthetic membrane},
  pages = {248-259},
  file = {C:\\Users\\kacar\\Zotero\\storage\\DZEF2PHG\\Bishop et al. - 1980 - Monolayer properties of chloroplast lipids.pdf;C:\\Users\\kacar\\Zotero\\storage\\E2NCKDZT\\0005273680903089.html}
}


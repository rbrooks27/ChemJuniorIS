  file = {C:\\Users\\kacar\\Zotero\\storage\\GS2V2J8Q\\Wren et al. - 2015 - Hydration, Orientation, and Conformation of Methyl.pdf;C:\\Users\\kacar\\Zotero\\storage\\DB6D7CZR\\acs.jpca.html}
}


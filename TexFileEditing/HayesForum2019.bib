@article{mirandaInteractionWaterFatty1998,
  title = {Interaction of Water with a Fatty Acid {{Langmuir}} Film},
  volume = {286},
  issn = {0009-2614},
  abstract = {Using sum-frequency vibrational spectroscopy we have studied the structure of the fatty acid monolayer\textendash{}water interface as a function of pH of water. At low pH values, the monolayer is neutral and the surface water structure is disordered by hydrogen bonding of water molecules with the acid head-groups. At high pH values, acid head-groups are ionized and the resulting surface field helps the surface water molecules form a more ordered hydrogen-bonding network. At pH {$\sim$}3, a small change in pH leads to a reorientation of the acid OH groups while the alkyl chains remain conformationally ordered at all pH values.},
  number = {1\textendash{}2},
  journal = {Chemical Physics Letters},
  doi = {10.1016/S0009-2614(97)01476-0},
  author = {Miranda, P. B. and Du, Q. and Shen, Y. R.},
  month = apr,

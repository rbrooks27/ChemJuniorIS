@article{ipEffectiveHenryLaw2009,
  title = {Effective {{Henry}}'s Law Constants of Glyoxal, Glyoxylic Acid, and Glycolic Acid},
  volume = {36},
  issn = {1944-8007},
  abstract = {The Henry's law constants of glyoxal, glycolic acid and glyoxylic acid in pure water were determined over the range of 278 and 308 K for the first time by a bubble column technique. These compounds were chosen because of their perceived involvement in the formation of secondary organic aerosol through in-cloud processing pathways. The experimentally determined Henry's law constants are: glyoxal, KH = 4.19 \texttimes{} 105 \texttimes{} exp[(62.2 \texttimes{} 103/R) \texttimes{} (1/T - 1/298)]; glycolic acid, KH = 2.83 \texttimes{} 104 \texttimes{} exp[(33.5 \texttimes{} 103/R) \texttimes{} (1/T - 1/298)]; and glyoxylic acid, KH = 1.09 \texttimes{} 104 \texttimes{} exp[(40.0 \texttimes{} 103/R) \texttimes{} (1/T - 1/298)]. The Henry's law constants of glyoxal in the presence of sodium chloride and sodium sulfate were also determined at 298 K. While the glyoxal KH is enhanced by less than three times in the presence of chloride in the range of 0.05\textendash{}4.0 M ionic strength, the presence of sulfate at 0.03 M ionic strength increases the glyoxal KH by 50 times.},
  language = {en},
  number = {1},
  journal = {Geophys. Res. Lett.},
  doi = {10.1029/2008GL036212},
  author = {Ip, H. S. Simon and Huang, X. H. Hilda and Yu, Jian Zhen},
  month = jan,
  year = {2009},
  keywords = {0305 Aerosols and particles,0365 Troposphere: composition and chemistry,0368 Troposphere: constituent transport and chemistry,0320 Cloud physics and chemistry,0345 Pollution: urban and regional,gas-cloud partitioning,in-cloud processing,Oxalic acid},
  pages = {L01802},
  file = {C:\\Users\\kacar\\Zotero\\storage\\N3J7ZASZ\\Ip et al. - 2009 - Effective Henry's law constants of glyoxal, glyoxy.pdf;C:\\Users\\kacar\\Zotero\\storage\\DXHNHHWC\\abstract.html}
}

@article{rinaldiEvidenceNaturalMarine2011,
  title = {Evidence of a Natural Marine Source of Oxalic Acid and a Possible Link to Glyoxal},
  volume = {116},
  issn = {2156-2202},
  abstract = {This paper presents results supporting the existence of a natural source of oxalic acid over the oceans. Oxalate was detected in ``clean-sector'' marine aerosol samples at Mace Head (Ireland) (53\textdegree{}20{${'}$}N, 9\textdegree{}54{${'}$}W) during 2006, and at Amsterdam Island (37\textdegree{}48{${'}$}S, 77\textdegree{}34{${'}$}E) from 2003 to 2007, in concentrations ranging from 2.7 to 39 ng m-3 and from 0.31 to 17 ng m-3, respectively. The oxalate concentration showed a clear seasonal trend at both sites, with maxima in spring-summer and minima in fall-winter, being consistent with other marine biogenic aerosol components (e.g., methanesulfonic acid, non-sea-salt sulfate, and aliphatic amines). The observed oxalate was distributed along the whole aerosol size spectrum, with both a submicrometer and a supermicrometer mode, unlike the dominant submicrometer mode encountered in many polluted environments. Given its mass size distribution, the results suggest that over remote oceanic regions oxalate is produced through a combination of different formation processes. It is proposed that the cloud-mediated oxidation of gaseous glyoxal, recently detected over remote oceanic regions, may be an important source of submicrometer oxalate in the marine boundary layer. Supporting this hypothesis, satellite-retrieved glyoxal column concentrations over the two sampling sites exhibited the same seasonal concentration trend of oxalate. Furthermore, chemical box model simulations showed that the observed submicrometer oxalate concentrations were consistent with the in-cloud oxidation of typical marine air glyoxal mixing ratios, as retrieved by satellite measurements, at both sites.},
  language = {en},
  number = {D16},
  journal = {J. Geophys. Res.},
  doi = {10.1029/2011JD015659},
  author = {Rinaldi, Matteo and Decesari, Stefano and Carbone, Claudio and Finessi, Emanuela and Fuzzi, Sandro and Ceburnis, Darius and O'Dowd, Colin D. and Sciare, Jean and Burrows, John P. and Vrekoussis, Mihalis and Ervens, Barbara and Tsigaridis, Kostas and Facchini, Maria Cristina},
  month = aug,
  year = {2011},
  keywords = {0305 Aerosols and particles,3311 Clouds and aerosols,marine aerosol,0320 Cloud physics and chemistry,0322 Constituent sources and sinks,Oxalic acid,cloud processes,Glyoxal,SOA},
  pages = {D16204},
  file = {C:\\Users\\kacar\\Zotero\\storage\\GI6A849N\\Rinaldi et al. - 2011 - Evidence of a natural marine source of oxalic acid.pdf;C:\\Users\\kacar\\Zotero\\storage\\KQ57DDH7\\abstract.html}
}

@article{mahajanGlyoxalObservationsGlobal2014,
  title = {Glyoxal Observations in the Global Marine Boundary Layer},
  volume = {119},
  issn = {2169-8996},
  abstract = {Glyoxal is an important intermediate species formed by the oxidation of common biogenic and anthropogenic volatile organic compounds such as isoprene, toluene, and acetylene. Although glyoxal has been shown to play an important role in urban and forested environments, its role in the open ocean environment is still not well understood, with only a few observations showing evidence for its presence in the open ocean marine boundary layer (MBL). In this study, we report observations of glyoxal from 10 field campaigns in different parts of the world's oceans. These observations together represent the largest database of glyoxal in the MBL. The measurements are made with similar instruments that have been used in the past, although the open ocean values reported here, average of about 25 parts per trillion by volume (pptv) with an upper limit of 40 pptv, are much lower than previously reported observations that were consistently higher than 40 pptv and had an upper limit of 140 pptv, highlighting the uncertainties in the differential optical absorption spectroscopy method for the retrieval of glyoxal. Despite retrieval uncertainties, the results reported in this work support previous suggestions that the currently known sources of glyoxal are insufficient to explain the average MBL concentrations. This suggests that there is an additional missing source, more than a magnitude larger than currently known sources, which is necessary to account for the observed atmospheric levels of glyoxal. Therefore, it could play a more important role in the MBL than previously considered.},
  language = {en},
  number = {10},
  journal = {J. Geophys. Res. Atmos.},
  doi = {10.1002/2013JD021388},
  author = {Mahajan, Anoop S. and {Prados-Roman}, Cristina and Hay, Timothy D. and Lampel, Johannes and P{\"o}hler, Denis and Gro{$\beta$}mann, Katja and Tschritter, Jens and Frie{\ss}, Udo and Platt, Ulrich and Johnston, Paul and Kreher, Karin and Wittrock, Folkard and Burrows, John P. and Plane, John M.C. and {Saiz-Lopez}, Alfonso},
  month = may,
  year = {2014},
  keywords = {0365 Troposphere: composition and chemistry,0312 Air/sea constituent fluxes,0322 Constituent sources and sinks,marine boundary layer,Glyoxal,oxidizing capacity,secondary organic aerosol,volatile organic compounds},
  pages = {2013JD021388},

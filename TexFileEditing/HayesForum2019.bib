@article{mcdermottDNAChiralSpine2017,
  title = {{{DNA}}'s {{Chiral Spine}} of {{Hydration}}},
  volume = {3},
  issn = {2374-7943},
  abstract = {The iconic helical structure of DNA is stabilized by the solvation environment, where a change in the hydration state can lead to dramatic changes to the DNA structure. X-ray diffraction experiments at cryogenic temperatures have shown crystallographic water molecules in the minor groove of DNA, which has led to the notion of a spine of hydration of DNA. Here, chiral nonlinear vibrational spectroscopy of two DNA sequences shows that not only do such structural water molecules exist in solution at ambient conditions but that they form a chiral superstructure: a chiral spine of hydration. This is the first observation of a chiral water superstructure templated by a biomolecule. While the biological relevance of a chiral spine of hydration is unknown, the method provides a direct way to interrogate the properties of the hydration environment of DNA and water in biological settings without the use of labels.},
  number = {7},
  journal = {ACS Cent. Sci.},
  doi = {10.1021/acscentsci.7b00100},
  author = {McDermott, M. Luke and Vanselous, Heather and Corcelli, Steven A. and Petersen, Poul B.},
  month = jul,
  year = {2017},
  pages = {708-714},
  file = {C:\\Users\\kacar\\Zotero\\storage\\KTNH85UN\\McDermott et al. - 2017 - DNA’s Chiral Spine of Hydration.pdf;C:\\Users\\kacar\\Zotero\\storage\\BFI6XCXS\\acscentsci.html}
}

@article{okunoSymmetricRamanTensor2017,
  title = {Symmetric {{Raman Tensor Contributes}} to {{Chiral Vibrational Sum}}-{{Frequency Generation}} from {{Binaphthyl Amphiphile Monolayers}} on {{Water}}: {{Study}} of {{Electronic Resonance Amplitude}} and {{Phase Profiles}}},
  volume = {121},
  issn = {1932-7447},
  shorttitle = {Symmetric {{Raman Tensor Contributes}} to {{Chiral Vibrational Sum}}-{{Frequency Generation}} from {{Binaphthyl Amphiphile Monolayers}} on {{Water}}},
  abstract = {Heterodyne-detected vibrationally electronically doubly resonant chiral sum-frequency generation (HD-DR chiral SFG) spectra were observed for the first time on monolayers. Langmuir monolayers of R- and S-binaphthyl amphiphiles on water exhibited complex chiral vibrational sum frequency generation (VSFG) spectra whose amplitudes were approximately the same, but whose phases were different by {$\pi$}. By comparing the electronic resonance profiles of the chiral VSFG signal amplitude and phase with simulations based on a nonadiabatic resonance Raman theory, we concluded that the chiral VSFG signals from the monolayers originated not from the antisymmetric Raman tensor but from the symmetric one. This is the first experimental evidence that the symmetric Raman tensor indeed contributes to the chiral VSFG signals from oriented monolayer systems.},
  number = {21},
  journal = {J. Phys. Chem. C},
  doi = {10.1021/acs.jpcc.6b12664},
  author = {Okuno, Masanari and Ishikawa, Daisuke and Nakanishi, Waka and Ariga, Katsuhiko and Ishibashi, Taka-aki},
  month = jun,
  year = {2017},
  pages = {11241-11250},
  file = {C:\\Users\\kacar\\Zotero\\storage\\3QWB49YS\\Okuno et al. - 2017 - Symmetric Raman Tensor Contributes to Chiral Vibra.pdf;C:\\Users\\kacar\\Zotero\\storage\\UQWZX2UU\\acs.jpcc.html}
}

@article{meisterObservationPHInducedProtein2017,
  title = {Observation of {{pH}}-{{Induced Protein Reorientation}} at the {{Water Surface}}},
  volume = {8},
  issn = {1948-7185},
  abstract = {Hydrophobins are surface-active proteins that form a hydrophobic, water-repelling film around aerial fungal structures. They have a compact, particle-like structure, in which hydrophilic and hydrophobic regions are spatially separated. This surface property renders them amphiphilic and is reminiscent of synthetic Janus particles. Here we report surface-specific chiral and nonchiral vibrational sum-frequency generation spectroscopy (VSFG) measurements of hydrophobins adsorbed to their natural place of action, the air\textendash{}water interface. We observe that hydrophobin molecules undergo a reversible change in orientation (tilt) at the interface when the pH is varied. We explain this local orientation toggle from the modification of the interprotein interactions and the interaction of hydrophobin with the water solvent, following the pH-induced change of the charge state of particular amino acids.},
  number = {8},
  journal = {J. Phys. Chem. Lett.},
  doi = {10.1021/acs.jpclett.7b00394},
  author = {Meister, Konrad and Roeters, Steven J. and Paananen, Arja and Woutersen, Sander and Versluis, Jan and Szilvay, G{\'e}za R. and Bakker, Huib J.},

@article{agrawalSurfaceDiffusionMonomolecular1988a,
  title = {Surface Diffusion in Monomolecular Films: {{I}}. {{Lateral}} Profile Shift in Radiotracer Method},
  volume = {121},
  issn = {0021-9797},
  shorttitle = {Surface Diffusion in Monomolecular Films},
  abstract = {The lateral shift of the surface concentration profiles was systematically investigated during a study directed at obtaining reliable surface diffusion data for myristic acid monolayers on 0.01 N HCl subsolutions using the radiotracer technique. Variable profile shifts, both with regard to direction and magnitude, can occur due to lateral temperature gradients if surface diffusion experiments are not performed carefully. However, when the temperature and humidity are stringently controlled, the profile shift becomes regular and always shifts toward the radioactive film side of the trough. Monolayer characterization studies showed that there were no differences between the II-{$\Delta$}V-A isotherms of high purity radioactive and nonradioactive myristic acid monomolecular films below the equilibrium spreading pressure. However, film stability measurements indicated that the freshly purified radioactive surfactant undergoes significant decomposition, not only during storage, but also when it is spread on the subsolution surface for monolayer studies. Subsequent evaporation and dissolution of decomposition products from the radioactive portion of the surface film in diffusion measurements give rise to an instantaneous surface tension gradient and, hence, a shift of the boundary between the radioactive and nonradioactive films. The lateral profile shift, therefore, does not arise from temperature-induced Rayleigh instabilities as claimed recently by D. Vollhardt and co-workers [Colloid Polym. Sci. 258, 1176 (1980)], but rather it results from uncqual monolayer losses as proposed earlier by J. H. Wirz and R. D. Neuman [J. Colloid Interface Sci. 63, 583 (1978)].},
  number = {2},
  journal = {Journal of Colloid and Interface Science},
  doi = {10.1016/0021-9797(88)90439-0},
  author = {Agrawal, M. L and Neuman, Ronald D},
  month = feb,
  year = {1988},
  pages = {355-365},
  file = {C:\\Users\\kacar\\Zotero\\storage\\AJWCMUG6\\Agrawal and Neuman - 1988 - Surface diffusion in monomolecular films I. Later.pdf;C:\\Users\\kacar\\Zotero\\storage\\EV6HKBCG\\0021979788904390.html}
}

@article{agrawalSurfaceDiffusionMonomolecular1988,
  title = {Surface Diffusion in Monomolecular Films: {{II}}. {{Experiment}} and Theory},
  volume = {121},
  issn = {0021-9797},
  shorttitle = {Surface Diffusion in Monomolecular Films},
  abstract = {Surface diffusion in myristic acid monolayers at the air\textemdash{}water interface was investigated using a radiotracer technique. Surface self-diffusion coefficients (Ds) were determined at various surface concentrations in the liquid-expanded state at 20, 25, and 30\textdegree{}C with an improved experimental apparatus. Ds values as much as two orders of magnitude smaller than those reported earlier for the liquid-expanded state were obtained because we were able to minimize the confounding problem of extraneous surface convective flows by stringent temperature ({$\pm$}0.02\textdegree{}C) and humidity (saturation) control. The equilibrium density fluctuation model of M. Blank and J. S. Britten [J. Colloid Sci. 20, 789 (1965)] was extended to liquid-expanded monolayers, and the theoretical predictions were found to agree well with experimental results. Agreement between experiment and theory, however, requires that the entropy changes associated with the density fluctuations be properly evaluated. There appears to be two regimes of surface diffusion: one strongly surface concentration dependent and the other only weakly dependent on surface concentration. In the latter regime, our findings clearly provide support for a ``free area'' mechanism of surface diffusion due to thermal fluctuations in the surface density of the monomolecular film. On the other hand, the measured lateral mobility is much faster in the former regime; presumably multiple exchange of the film molecules or another transport mechanism becomes significant.},
  number = {2},
  journal = {Journal of Colloid and Interface Science},
  doi = {10.1016/0021-9797(88)90440-7},
  author = {Agrawal, M. L and Neuman, Ronald D},
  month = feb,
  year = {1988},
  pages = {366-380},
  file = {C:\\Users\\kacar\\Zotero\\storage\\DZ2VCX4G\\Agrawal and Neuman - 1988 - Surface diffusion in monomolecular films II. Expe.pdf;C:\\Users\\kacar\\Zotero\\storage\\HI29ZC9J\\0021979788904407.html}
}


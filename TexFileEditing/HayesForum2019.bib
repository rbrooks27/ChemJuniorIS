@article{johnsonVibrationalSumFrequency2009,
  title = {Vibrational {{Sum Frequency Spectroscopy Study}} of the {{Liquid}}/{{Vapor Interface}} of {{Formic Acid}}/{{Water Solutions}}},
  volume = {113},
  issn = {1932-7447},
  abstract = {The liquid/vapor interface of aqueous formic acid solutions has been studied by vibrational sum frequency spectroscopy (VSFS) in the concentration range extending from water to pure formic acid. Throughout the whole concentration range, the acid molecules at the surface were found to be protonated, and no evidence of the dissociated form was found. A comprehensive picture of the adsorption and structural behavior was obtained by targeting the CH/OH and the C=O stretching regions. The main spectral features were the CH stretch at {$\sim$}2926 cm-1 and the C=O stretching vibration at {$\sim$}1720 cm-1, in addition to the OH stretching bands of water. Information regarding the orientation of the interfacial formic acid molecules was also obtained. The tilt angles (\texttheta{}) of the CH and C=O bonds from the surface normal were determined to be basically concentration independent and attained values in the ranges of 27\textdegree{} {$<$} \texttheta{}CH {$<$} 43\textdegree{} and 42\textdegree{} {$<$} \texttheta{}C=O {$<$} 57\textdegree. Various models for the surface structure are discussed based on the spectral evolution in the whole concentration range, and a comparison is made to the adsorption behavior of acetic acid from an aqueous solution, which has been previously studied under similar conditions.},
  number = {30},
  journal = {J. Phys. Chem. C},
  doi = {10.1021/jp9016618},
  author = {Johnson, C. Magnus and Tyrode, Eric and Kumpulainen, Atte and Leygraf, Christofer},
  month = jul,
  year = {2009},
  pages = {13209-13218},
  file = {C:\\Users\\kacar\\Zotero\\storage\\GXE58WGJ\\Johnson et al. - 2009 - Vibrational Sum Frequency Spectroscopy Study of th.pdf;C:\\Users\\kacar\\Zotero\\storage\\BQMRWRDI\\jp9016618.html}
}


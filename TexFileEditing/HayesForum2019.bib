  keywords = {Fatty Acids,Air,Chemical Phenomena,Chemistry; Physical,Hydrogen-Ion Concentration,Oxidation-Reduction,Oxygen,Pressure,Solubility,Surface Properties,Temperature,Water},
  pages = {195-200},
  file = {C:\\Users\\kacar\\Zotero\\storage\\SNJ6KAUH\\195.full.pdf},

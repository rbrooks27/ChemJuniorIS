  month = jan,
  year = {2017},
  pages = {195-197},
  file = {C:\\Users\\kacar\\Zotero\\storage\\JU8URHFM\\Michaelides and Slater - 2017 - Melting the ice one layer at a time.pdf;C:\\Users\\kacar\\Zotero\\storage\\JLH9ILDG\\195.html},

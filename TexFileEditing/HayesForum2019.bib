  title = {Separating the {{pH}}-{{Dependent Behavior}} of {{Water}} in the {{Stern}} and {{Diffuse Layers}} with {{Varying Salt Concentration}}},
  volume = {121},
  issn = {1932-7447, 1932-7455},
  abstract = {Vibrational sum frequency generation (SFG) spectroscopy was utilized to distinguish different populations of water molecules within the electric double layer (EDL) at the silica/water interface. By systematically varying the electrolyte concentration, surface deprotonation, and SFG polarization combinations, we provide evidence of two regions of water molecules that have distinct pH-dependent behavior when the Stern layer is present (with onset between 10 and 100 mM NaCl). For example, water molecules near the surface in the Stern layer can be probed by the pss polarization combination, while other polarization combinations (ssp and ppp) predominantly probe water molecules further from the surface in the diffuse part of the electrical double layer. For the water molecules adjacent to the surface within the Stern layer, upon increasing the pH from the point-of-zero charge of silica (pH {$\sim$}2) to higher values (pH {$\sim$}12), we observe an increase in alignment consistent with a more negative surface with increasing pH. In contrast, water molecules further from the surface appear to exhibit a net flip in orientation upon increasing the pH over the same range, which we attribute to the presence of the Stern layer and possible overcharging of the EDL at lower pH. The opposing pH-dependent behavior of water in these two regions sheds new light on our understanding of the water structure within the EDL at high salt concentrations when the Stern layer is present.},
  language = {en},
  number = {37},
  journal = {J. Phys. Chem. C},
  doi = {10.1021/acs.jpcc.7b03522},
  author = {Darlington, Akemi M. and Jarisz, Tasha A. and {DeWalt-Kerian}, Emma L. and Roy, Sandra and Kim, Sun and Azam, Md. Shafiul and Hore, Dennis K. and Gibbs, Julianne M.},
  month = sep,
  year = {2017},
  pages = {20229-20241},
  file = {C:\\Users\\kacar\\Zotero\\storage\\FACRQ49Y\\Darlington et al. - 2017 - Separating the pH-Dependent Behavior of Water in t.pdf}
}


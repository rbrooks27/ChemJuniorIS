@article{danovInterpretationSurfacetensionIsotherms2006,
  title = {Interpretation of Surface-Tension Isotherms of n-Alkanoic (Fatty) Acids by Means of the van Der {{Waals}} Model},
  volume = {300},
  issn = {0021-9797},
  abstract = {Here we apply the two-dimensional van der Waals model to interpret surface-tension isotherms of aqueous solutions of n-alkanoic (fatty) acids. We processed available experimental data for a homologous series of eight acids, from pentanoic to dodecanoic (lauric). Only three adjustable parameters have been varied to fit simultaneously all experimental curves. Excellent agreement between the theoretical model and the experiment has been obtained. The determined parameter values comply well with the molecular properties and allow one to calculate the surfactant adsorption, surface elasticity, and the surface pressure vs area isotherms. For the dodecanoic acid, the van der Waals model indicates the existence of a surface phase transition.},
  number = {2},
  journal = {Journal of Colloid and Interface Science},
  doi = {10.1016/j.jcis.2006.04.026},
  author = {Danov, K. D. and Kralchevsky, P. A. and Ananthapadmanabhan, K. P. and Lips, A.},
  month = aug,
  year = {2006},
  keywords = {Adsorption,-Alkanoic acids,Normal fatty acids,Surface (Gibbs) elasticity,Surface pressure,Surface-tension isotherms},
  pages = {809-813},
  file = {C:\\Users\\kacar\\Zotero\\storage\\M9AM7KLW\\Danov et al. - 2006 - Interpretation of surface-tension isotherms of n-a.pdf;C:\\Users\\kacar\\Zotero\\storage\\FVPL52NH\\S0021979706003225.html}

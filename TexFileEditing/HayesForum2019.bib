@article{scheferUnravellingSecondaryStructure2014,
  title = {Unravelling {{Secondary Structure Changes}} on {{Individual Anionic Polysaccharide Chains}} by {{Atomic Force Microscopy}}},
  volume = {53},
  copyright = {\textcopyright{} 2014 The Authors. Published by Wiley-VCH Verlag GmbH \& Co. KGaA. This is an open access article under the terms of the Creative Commons Attribution License, which permits use, distribution and reproduction in any medium, provided the original work is properly cited.},
  issn = {1521-3773},
  abstract = {The structural conformations of the anionic carrageenan polysaccharides in the presence of monovalent salt close to physiological conditions are studied by atomic force microscopy. Iota-carrageenan undergoes a coil\textendash{}helix transition at high ionic strength, whereas lambda-carrageenan remains in the coiled state. Polymer statistical analysis reveals an increase in persistence length from 22.6{$\pm$}0.2 nm in the random coil, to 26.4{$\pm$}0.2 nm in the ordered helical conformation, indicating an increased rigidity of the helical iota-carrageenan chains. The many decades-long debated issue on whether the ordered state can exist as single or double helix, is conclusively resolved by demonstrating the existence of a unimeric helix formed intramolecularly by a single polymer chain.},
  language = {en},
  number = {21},
  journal = {Angew. Chem. Int. Ed.},
  doi = {10.1002/anie.201402855},
  author = {Schefer, Larissa and Adamcik, Jozef and Mezzenga, Raffaele},
  year = {2014},
  keywords = {carbohydrates,atomic force microscopy,coil–helix transition,conformation analysis,polymer physics},
  pages = {5376-5379},
  file = {C:\\Users\\kacar\\Zotero\\storage\\CGLSPBFV\\Schefer et al. - 2014 - Unravelling Secondary Structure Changes on Individ.pdf;C:\\Users\\kacar\\Zotero\\storage\\XCPNDS5C\\downloadSupplement.pdf;C:\\Users\\kacar\\Zotero\\storage\\8WUTXT74\\anie.html}
}


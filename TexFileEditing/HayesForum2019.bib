  volume = {337},
  issn = {0008-6215},
  shorttitle = {Effect of Calcium Ions on the Organization of Iota-Carrageenan Helices},
  abstract = {X-ray fiber diffraction analysis confirms that calcium {$\iota$}-carrageenan forms a threefold, right-handed, half-staggered, parallel, double helix of pitch 26.42 {\AA} stabilized by interchain hydrogen bonds. According to the detailed structural results, three helices are packed in a trigonal unit cell (a=23.61 and c=13.21 {\AA}). Strong interactions between the sulfate groups of neighboring helices, mediated by calcium ions and water molecules, are responsible for stabilizing the three-dimensional structure.},

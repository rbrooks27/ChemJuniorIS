@article{thompsonSumFrequencyGeneration2013,
  title = {Sum {{Frequency Generation Study}} of the {{Interfacial Layer}} in {{Liquid}}-{{Phase Heterogeneously Catalyzed Oxidation}} of 2-{{Propanol}} on {{Platinum}}: {{Effect}} of the {{Concentrations}} of {{Water}} and 2-{{Propanol}} at the {{Interface}}},
  volume = {117},
